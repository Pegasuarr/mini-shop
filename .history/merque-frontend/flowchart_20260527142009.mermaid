flowchart TD
    %% Styling Configuration
    classDef startEnd fill:#f9f,stroke:#333,stroke-width:2px;
    classDef frontend fill:#bbf,stroke:#333,stroke-width:2px;
    classDef backend fill:#f96,stroke:#333,stroke-width:2px;
    classDef database fill:#9f9,stroke:#333,stroke-width:2px;

    Start([Start Application]) :::startEnd
    
    %% Frontend Flow
    ShowProducts[Frontend: Display Product Catalog] :::frontend
    ClickProduct[Frontend: User Clicks on a Product] :::frontend
    AddToCart[Frontend: Push Item to Cart State via JavaScript] :::frontend
    ViewCart[Frontend: Open Cart Page & Calculate Total Price] :::frontend
    ClickOrder[Frontend: User Clicks 'Order' Button] :::frontend
    FetchAPI[Frontend: Send Order Data to Backend <br> via JS Fetch/Axios API] :::frontend

    %% Backend & Database Flow
    ReceiveData[Backend: Receive Incoming Order Payload] :::backend
    CheckData{Backend: Is Data <br> Valid?} :::backend
    SaveDB[(Database: Save Order & <br> Transaction Details)] :::database
    
    %% Responses
    SuccessRes[Backend: Return Success Response to Client] :::backend
    FailRes[Backend: Return Error Response to Client] :::backend
    
    ShowSuccess[Frontend: Show 'Order Placed successfully!' Popup] :::frontend
    ShowError[Frontend: Show 'Order Failed' Notification] :::frontend
    
    End([End Process]) :::startEnd

    %% Connectivity Flow
    Start --> ShowProducts
    ShowProducts --> ClickProduct
    ClickProduct --> AddToCart
    AddToCart --> ViewCart
    ViewCart --> ClickOrder
    ClickOrder --> FetchAPI
    FetchAPI --> ReceiveData
    ReceiveData --> CheckData
    
    CheckData -- Yes --> SaveDB
    CheckData -- No --> FailRes
    
    SaveDB --> SuccessRes
    SuccessRes --> ShowSuccess
    FailRes --> ShowError
    
    ShowSuccess --> End
    ShowError --> ViewCart