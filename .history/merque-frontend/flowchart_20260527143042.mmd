flowchart TD
    classDef startEnd fill:#f9f,stroke:#333,stroke-width:2px
    classDef frontend fill:#bbf,stroke:#333,stroke-width:2px
    classDef backend fill:#f96,stroke:#333,stroke-width:2px
    classDef database fill:#9f9,stroke:#333,stroke-width:2px
    classDef decision fill:#ff9,stroke:#333,stroke-width:2px

    Start([User Opens Mini Shop Web App]):::startEnd

    %% Frontend - Product Display
    LoadProducts[Frontend: Fetch and Display Product List on Homepage]:::frontend
    ViewProduct[Frontend: User Clicks Product to View Details]:::frontend
    AddToCart[Frontend: Add to Cart - Store in JavaScript Memory or Local Storage]:::frontend
    ViewCart[Frontend: Open Cart Page - Show Selected Items and Calculate Total Price]:::frontend

    %% Order Decision
    ContinueShopping{Continue Shopping?}:::decision
    ClickOrder[Frontend: User Clicks Order Button]:::frontend

    %% API Call
    FetchAPI[Frontend: Send Order Payload to Backend via JS Fetch or Axios API]:::frontend

    %% Backend Processing
    ReceiveData[Backend: Receive Incoming Order Payload from Client]:::backend
    ValidateData{Backend: Is Order Data Valid?}:::decision

    %% Validation Branches
    SaveDB[(Database: Save Order and Transaction Details Automatically)]:::database
    FailValidation[Backend: Return 400 Error Response to Client]:::backend

    %% Response Handling
    SuccessRes[Backend: Return 200 Success Response to Client]:::backend
    ShowSuccess[Frontend: Display Order Placed Successfully Popup]:::frontend
    ShowError[Frontend: Display Order Failed Notification]:::frontend

    End([End - Order Process Complete]):::startEnd

    %% Flow
    Start --> LoadProducts
    LoadProducts --> ViewProduct
    ViewProduct --> AddToCart
    AddToCart --> ViewCart
    ViewCart --> ContinueShopping
    ContinueShopping -- Yes --> LoadProducts
    ContinueShopping -- No --> ClickOrder
    ClickOrder --> FetchAPI
    FetchAPI --> ReceiveData
    ReceiveData --> ValidateData
    ValidateData -- Valid --> SaveDB
    ValidateData -- Invalid --> FailValidation
    SaveDB --> SuccessRes
    SuccessRes --> ShowSuccess
    FailValidation --> ShowError
    ShowError --> ViewCart
    ShowSuccess --> End